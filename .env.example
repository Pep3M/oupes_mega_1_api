# Address of your Oupes device. Leave unset to auto-detect it on the LAN --
# but broadcast discovery is blocked by some access points, so if the backend
# reports "no device found", run `python3 discover.py` and pin the address here.
#MEGA_HOST=192.168.1.42

# Samples kept in the in-memory /history ring (~1Hz, so 600 is ~10 minutes).
HISTORY_SIZE=600

# Port the backend and dashboard listen on.
PORT=8765
