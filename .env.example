# Address of your Oupes device. Leave unset to auto-detect it on the LAN --
# but broadcast discovery is blocked by some access points, so if the backend
# reports "no device found", run `python3 discover.py` and pin the address here.
#MEGA_HOST=192.168.1.42

# Samples kept in the in-memory /history ring (~1Hz, so 600 is ~10 minutes).
HISTORY_SIZE=600

# Long-term battery history: a SQLite file with one row a minute (plus one at
# every percentage step), which is what the bar widget's chart draws. In the
# container this is the mounted volume. Set it empty to turn persistence off.
HISTORY_DB=/data/battery.db

# Seconds between stored battery samples, and how long rows are kept.
BATTERY_SAMPLE_S=60
BATTERY_RETENTION_DAYS=30

# Port the backend and dashboard listen on.
PORT=8765

# Seconds between retries while no device has been found yet.
DISCOVERY_RETRY_S=30

# Backend log verbosity. DEBUG shows each discovery probe.
LOG_LEVEL=INFO
